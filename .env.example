# ====== Frontend (apps/web) ======
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Required only for the live map plot-selection module:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ====== Backend (apps/api) ======
# Anything other than "development" is treated as production (strict secrets, no dev OTP echo).
ENV=development
DATABASE_URL=postgresql+asyncpg://planner:planner@localhost:5432/planner
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3100

# Security — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MIN=10
RATE_LIMIT=120/minute

# Email for OTP codes. Unset SMTP_HOST: dev logs codes to the API console;
# production refuses to issue codes (503) instead of silently dropping them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Plot Planner <no-reply@example.com>
SMTP_STARTTLS=true

# Google OAuth (server-side ID-token verification). GOOGLE_CLIENT_ID is the
# web client ID from Google Cloud Console; /auth/google returns 503 without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (Stripe / Razorpay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude via Google Vertex AI (optional — enables AI design critique on
# /ai/suggestions). Leave PROJECT_ID blank to disable and fall back to the
# deterministic engine. Auth uses Application Default Credentials
# (gcloud auth application-default login, or a service-account JSON via
# GOOGLE_APPLICATION_CREDENTIALS).
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=global
# claude-opus-4-8 is current; pin claude-opus-4-7 if your region lacks 4.8.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=2048
