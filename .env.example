# ====== Frontend (apps/web) — copy to apps/web/.env.local ======
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Google Maps JavaScript API (Maps JavaScript, Places, Geocoding). Without it the
# plot module uses an offline boundary editor. Restrict the key to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Supabase project (Settings → API). The publishable key is safe in the browser:
# every table is protected by row-level security. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ====== Backend (apps/api) ======
# Anything other than "development" is treated as production (SUPABASE_URL required).
ENV=development
# The API trusts Supabase access tokens from this project (verified via its public JWKS).
SUPABASE_URL=https://your-project.supabase.co
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3100
RATE_LIMIT=120/minute

# Pro unlock (₹499 per project) with Razorpay — leave blank to switch payments off.
# Use TEST-mode keys (rzp_test_...) until you go live. Both Razorpay keys and the
# Supabase service-role key are SECRETS: server only, never NEXT_PUBLIC_, never commit.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRO_PRICE_PAISE=49900
# Publishable key (same as the web app's) to check project ownership as the user;
# service-role key (Supabase → Settings → API keys → secret) to record verified payments.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude via Google Vertex AI (optional — AI design critique on /ai/suggestions).
# Leave PROJECT_ID blank to disable. Auth uses Application Default Credentials
# (gcloud auth application-default login, or GOOGLE_APPLICATION_CREDENTIALS).
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=global
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=2048
